#!/usr/bin/python3
# CUPS filter: application/vnd.cups-raster (1-bit K) -> Jiuyin D80 "NadaProtocol".
#
# Protocol (decompiled from com.zhuhaijiuyin.print 2.16.3, classes K7.e / K7.f):
#   1F 11 05 35 00            data mode: uncompressed (the app never compresses for D80)
#   1F 11 05 02 n             density 1..4
#   1D 76 30 00 wL wH hL hH   GS v 0 raster, w in bytes, then w*h bytes, MSB first, 1 = black
# Print head: 1664 dots (208 mm) at 8 dots/mm.
#
# argv: job-id user title copies options [file]

import os
import struct
import sys

HEAD_DOTS = 1664
HEAD_BYTES = HEAD_DOTS // 8
DOTS_PER_MM = 8


def log(level, msg):
    sys.stderr.write(f"{level}: rastertod80: {msg}\n")
    sys.stderr.flush()


def parse_options(s):
    opts = {}
    for tok in s.split():
        k, _, v = tok.partition("=")
        opts[k] = v
    return opts


def read_exact(f, n):
    buf = f.read(n)
    if len(buf) != n:
        raise EOFError
    return buf


class Raster:
    """Minimal CUPS raster reader: RaS2 (compressed v2) and RaS3 (uncompressed v3)."""

    def __init__(self, f):
        self.f = f
        sync = read_exact(f, 4)
        if sync in (b"RaS2", b"RaS3"):
            self.endian = ">"
        elif sync in (b"2SaR", b"3SaR"):
            self.endian = "<"
        else:
            raise ValueError(f"unsupported raster sync word {sync!r}")
        self.compressed = sync in (b"RaS2", b"2SaR")

    def pages(self):
        while True:
            try:
                hdr = read_exact(self.f, 1796)
            except EOFError:
                return
            u = lambda off: struct.unpack_from(self.endian + "I", hdr, off)[0]
            page = {
                "xdpi": u(276), "ydpi": u(280),
                "page_pts": (u(352), u(356)),
                "width": u(372), "height": u(376),
                "bpc": u(384), "bpp": u(388), "bpl": u(392),
                "cspace": u(400),
            }
            yield page, self._lines(page)

    def _lines(self, page):
        bpl, h = page["bpl"], page["height"]
        if not self.compressed:
            for _ in range(h):
                yield read_exact(self.f, bpl)
            return
        # v2 compression: per line a repeat count, then PackBits-like runs of
        # whole pixels; 128 = clear the rest of the line. 1-bit => 1-byte pixels.
        psize = max(1, page["bpp"] // 8)
        y = 0
        while y < h:
            rep = read_exact(self.f, 1)[0] + 1
            line = bytearray()
            while len(line) < bpl:
                n = read_exact(self.f, 1)[0]
                if n == 128:
                    line.extend(b"\x00" * (bpl - len(line)))
                elif n < 128:
                    line.extend(read_exact(self.f, psize) * (n + 1))
                else:
                    line.extend(read_exact(self.f, (257 - n) * psize))
            line = bytes(line[:bpl])
            for _ in range(min(rep, h - y)):
                yield line
                y += 1


def fit_line(line, width_dots, offset):
    """Crop/pad a 1-bit line to the head width, centred."""
    total_bits = len(line) * 8
    v = int.from_bytes(line, "big")
    if offset >= 0:
        v >>= max(0, total_bits - offset - HEAD_DOTS)
        v &= (1 << HEAD_DOTS) - 1
    else:
        v <<= max(0, HEAD_DOTS - total_bits - (-offset))
        v &= (1 << HEAD_DOTS) - 1
    return v.to_bytes(HEAD_BYTES, "big")


def main():
    if len(sys.argv) not in (6, 7):
        log("ERROR", "usage: rastertod80 job user title copies options [file]")
        return 1
    opts = parse_options(sys.argv[5])
    src = open(sys.argv[6], "rb") if len(sys.argv) == 7 else sys.stdin.buffer
    out = sys.stdout.buffer

    out.write(bytes([0x1F, 0x11, 0x05, 0x35, 0x00]))  # uncompressed
    darkness = opts.get("Darkness", "Default")
    if darkness.isdigit() and 1 <= int(darkness) <= 4:
        out.write(bytes([0x1F, 0x11, 0x05, 0x02, int(darkness)]))

    raster = Raster(src)
    pageno = 0
    for page, lines in raster.pages():
        pageno += 1
        # 1-bit only; K (3) has 1 = black, W (0) / SW (18) have 1 = white.
        if page["bpc"] != 1 or page["cspace"] not in (0, 3, 18):
            log("ERROR", f"need 1-bit K/W raster, got bpc={page['bpc']} cspace={page['cspace']}")
            return 1
        invert = page["cspace"] != 3
        # Exact physical page length so fanfold perforations stay aligned.
        page_rows = round(page["page_pts"][1] / 72 * 25.4 * DOTS_PER_MM)
        offset = (page["width"] - HEAD_DOTS) // 2
        log("INFO", f"Printing page {pageno}")
        log("DEBUG", f"page {pageno}: {page['width']}x{page['height']} @ {page['xdpi']}dpi "
                     f"-> {HEAD_DOTS}x{page_rows}, x-offset {offset}")
        body = bytearray()
        for i, line in enumerate(lines):
            if i < page_rows:
                if invert:
                    line = bytes(b ^ 0xFF for b in line)
                body += fit_line(line, page["width"], offset)
        rows = len(body) // HEAD_BYTES
        if rows < page_rows:
            body += b"\x00" * ((page_rows - rows) * HEAD_BYTES)
        out.write(bytes([0x1D, 0x76, 0x30, 0x00,
                         HEAD_BYTES & 255, HEAD_BYTES >> 8,
                         page_rows & 255, page_rows >> 8]))
        out.write(body)
        out.flush()
    log("DEBUG", f"done, {pageno} page(s)")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(1)
